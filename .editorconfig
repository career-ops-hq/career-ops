root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_style = tab
indent_size = 4

# Two trailing spaces are a hard line break in Markdown, so trimming them on
# save changes how the file renders (#6535).
[*.md]
trim_trailing_whitespace = false
