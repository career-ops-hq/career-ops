{
  "name": "career-ops",
  "version": "1.28.0",
  "description": "AI-powered job search pipeline \u2014 works with any AI coding CLI (Claude Code, Codex, OpenCode, Antigravity, Grok, Qwen, Kimi, Copilot)",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "doctor": "node doctor.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "liveness": "workflow/.venv/bin/python -B -m workflow.liveness_check",
    "workflow": "workflow/.venv/bin/python -B -m workflow.career_ops",
    "application:lifecycle": "workflow/.venv/bin/python -B -m workflow.career_ops application",
    "interview:context": "workflow/.venv/bin/python -B -m workflow.interview_tools context",
    "cv:maintain": "workflow/.venv/bin/python -B workflow/cv_maintenance.py"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fern\u00e1ndez de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.0",
    "js-yaml": "^5.3.0",
    "playwright": "1.62.1"
  }
}
